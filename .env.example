# Provider Priority: OPENAI_API_KEY > GROQ_API_KEY > GEMINI_API_KEY
OPENAI_API_KEY=your-openai-key
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional model override (defaults to provider's recommended model)
MODEL_NAME=gpt-4o-mini / llama-3.3-70b-versatile / gemini-2.5-flash
PORT=8000


